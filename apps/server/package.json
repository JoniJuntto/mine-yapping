    "@mine-yapping/db": "workspace:*",
    "@mine-yapping/env": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mine-yapping/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
